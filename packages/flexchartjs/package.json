{
    "name": "flexchartjs",
    "version": "1.0.6",
    "description": "A modern, responsive charting library for React",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
        "lint": "eslint src/**/*.ts"
    },
    "keywords": [
        "react",
        "charts",
        "dataviz",
        "visualization"
    ],
    "author": "FlexChartJS Team",
    "license": "MIT",
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tsup": "^8.0.2",
        "typescript": "^5.3.3",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0"
    }
}